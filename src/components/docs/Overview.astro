---
import ArticleCard from './ArticleCard.astro';
import { assetPath, defaultContext, docsPath, docsyConfig, type DocsContext } from '../../config';
import { message } from '../../lib/messages';
import { API_SECTIONS, filterEndpoints, loadSwagger } from '../../lib/swagger-loader';
import { findArticle, getArticleSources } from '../../lib/article-loader';
import { getSdkSources, loadSdk } from '../../lib/sdk-loaders';
import SDKLogo from './SDKLogo.astro';

interface Props { context?: DocsContext }
const { context = defaultContext } = Astro.props;
const home = { ...docsyConfig.home, ...docsyConfig.home.translations[context.locale] };
const spec = await loadSwagger(context.version);
const apiSections = API_SECTIONS.map((section) => ({
  ...section,
  endpointCount: filterEndpoints(spec, section).length,
  href: docsPath(`/api/${section.section}`, context),
}));
const articles = getArticleSources(context);
const sdks = getSdkSources().map((source) => ({ source, doc: loadSdk({ ...source, source: source.versions[context.version] ?? source.source }) }));
const available = (href: string) => !href.startsWith('/guides/') || Boolean(findArticle(href.slice(8), context));
---

  <div class:list={['docs-intro', { 'has-image': Boolean(home.image) }]}>
    <div class="docs-intro-copy">
      <h1>{home.title}</h1>
      <p class="lead">{home.description}</p>

      <div class="docs-cta-row">
        {available(home.primaryAction.href) && <a class="button button-dark" href={docsPath(home.primaryAction.href, context)}>{home.primaryActionLabel ?? home.primaryAction.label}</a>}
        {home.secondaryAction && available(home.secondaryAction.href) && (
          <a class="button button-light" href={docsPath(home.secondaryAction.href, context)}>{home.secondaryActionLabel ?? home.secondaryAction.label}</a>
        )}
      </div>
    </div>

    {home.image && (
      <img
        class="docs-intro-art"
        src={assetPath(home.image.src)}
        alt={home.image.alt}
        width={home.image.width}
        height={home.image.height}
      />
    )}
  </div>

  {sdks.length > 0 && <>
    <h2 id="sdk-reference">{message(context, 'sdkHeading', home.sdkHeading)}</h2>
    <p class="docs-section-description">{message(context, 'sdkDescription', home.sdkDescription)}</p>
    <div class="docs-sdk-grid">
      {sdks.map(({ source, doc }) => <a class="docs-sdk-card" href={docsPath(`/${source.slug}`, context)}>
        <div class="docs-sdk-head">
          <span class="docs-sdk-mark" aria-hidden="true">{source.icon ? <SDKLogo icon={assetPath(source.icon)} iconDark={source.iconDark ? assetPath(source.iconDark) : undefined} lazy /> : <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m8 6-6 6 6 6m8-12 6 6-6 6M14 3l-4 18" /></svg>}</span>
          <span class="docs-sdk-arrow" aria-hidden="true">→</span>
        </div>
        <h3>{source.name}</h3>
        <p>{source.overview}</p>
        <div class="docs-sdk-meta">{doc.itemCount} {message(context, 'symbols', 'symbols')} · {source.adapter}</div>
      </a>)}
    </div>
  </>}

  {articles.length > 0 && (
    <>
      <h2>{message(context, 'guides')}</h2>
      <p class="docs-section-description">{message(context, 'articlesDescription')}</p>
      <div class:list={['docs-article-grid', { 'is-list': home.articleLayout === 'list' }]}>
        {articles.map((article) => (
          <ArticleCard article={article} layout={home.articleLayout} context={context} />
        ))}
      </div>
    </>
  )}

  {apiSections.length > 0 && <h2>{message(context, 'apiReference')}</h2>}
  {apiSections.length > 0 && <p class="docs-section-description">Generated from the OpenAPI source configured in <code>docsy.config.yaml</code>.</p>}

  {apiSections.length > 0 && (
    <div class="docs-sdk-grid">
      {apiSections.map((section) => (
        <a class="docs-sdk-card" href={section.href}>
          <div class="docs-sdk-head">
            <span class="docs-sdk-mark" aria-hidden="true">
              <img src={assetPath('assets/sdks/bash.svg')} alt="" width="24" height="24" loading="lazy" />
            </span>
            <span class="docs-sdk-arrow" aria-hidden="true">&rarr;</span>
          </div>
          <h3>{section.title}</h3>
          <p>{section.description}</p>
          <div class="docs-sdk-meta">
            {section.endpointCount} {section.endpointCount === 1 ? 'endpoint' : 'endpoints'}
          </div>
        </a>
      ))}
    </div>
  )}


<style is:global>
  .docs-intro.has-image {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.35fr);
    gap: 28px;
    align-items: center;
  }

  .docs-intro-copy > h1 {
    margin-top: 0;
  }

  .docs-intro-art {
    width: 100%;
    height: auto;
    justify-self: end;
  }

  .docs-cta-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin: 24px 0 40px;
  }

  .docs-section-description {
    color: var(--muted) !important;
  }

  .docs-sdk-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin: 20px 0 24px;
  }

  .docs-article-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 24px 0;
  }

  .docs-article-grid.is-list {
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
  }

  .docs-sdk-card {
    display: block;
    min-width: 0;
    padding: 20px;
    border-radius: 14px;
    border: 1px solid #e1e2ea;
    background: var(--paper);
    text-decoration: none !important;
    color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  .docs-sdk-card:hover {
    border-color: rgba(81, 136, 255, 0.36);
    transform: translateY(-2px);
    box-shadow: 0 12px 26px -18px rgba(15, 16, 21, 0.2);
  }

  .docs-sdk-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .docs-sdk-mark {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: #fafafd;
    border: 1px solid #ebebf1;
  }

  .docs-sdk-arrow {
    color: var(--soft-muted);
    font-size: 14px;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .docs-sdk-card:hover .docs-sdk-arrow {
    color: var(--violet);
    transform: translateX(3px);
  }

  .docs-sdk-card h3 {
    margin: 0 0 4px !important;
    font-family: var(--font-display);
    font-size: 17px !important;
    font-weight: 500;
    color: var(--ink) !important;
  }

  .docs-sdk-card p {
    margin: 0 0 14px !important;
    color: var(--muted) !important;
    font-size: 13px !important;
    line-height: 1.5 !important;
  }

  .docs-sdk-meta {
    padding-top: 12px;
    border-top: 1px solid #ececf2;
    color: var(--soft-muted);
    font-family: var(--font-mono);
    font-size: 11.5px;
  }

  @media (max-width: 1000px) {
    .docs-intro.has-image {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .docs-intro-art {
      justify-self: start;
      max-width: 640px;
    }
  }

  @media (max-width: 720px) {
    .docs-sdk-grid,
    .docs-article-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
