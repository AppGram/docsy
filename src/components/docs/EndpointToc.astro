---
import type { NormalizedEndpoint } from '../../lib/swagger-loader';

interface Props {
  endpoints: NormalizedEndpoint[];
}

const { endpoints } = Astro.props;
---

{endpoints.length > 0 && (
  <nav class="docs-rail docs-rail-endpoints" aria-label="On this page">
    <p class="docs-rail-label">Endpoints</p>
    <ul>
      {endpoints.map((e) => (
        <li>
          <a href={`#${e.id}`}>
            <span class:list={['docs-rail-method', `is-${e.method}`]}>{e.method.toUpperCase()}</span>
            <span class="docs-rail-path">{e.path}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style is:global>
  .docs-rail-endpoints ul {
    display: grid;
    gap: 4px;
    border: 0 !important;
  }

  .docs-rail-endpoints a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 6px;
    margin-left: 0;
    border: 0;
    border-radius: 6px;
    justify-content: flex-start;
    min-width: 0;
    transition: background 0.12s ease;
  }

  .docs-rail-endpoints a:hover {
    background: rgba(15, 16, 21, 0.04);
    color: var(--ink) !important;
  }

  .docs-rail-method {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    height: 16px;
    padding: 0 5px;
    border-radius: 4px;
    color: #fff;
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;

  }

  .docs-rail-method.is-get    { background: #2b7cff; }
  .docs-rail-method.is-post   { background: #2c8b3a; }
  .docs-rail-method.is-put    { background: #b96f00; }
  .docs-rail-method.is-patch  { background: #b96f00; }
  .docs-rail-method.is-delete { background: #c73f28; }

  .docs-rail-path {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }
</style>
