---
import { defaultContext, docsPath, docsyConfig, locales, parseDocsPath, type DocsContext } from '../../config';
import { findArticle } from '../../lib/article-loader';
import { message } from '../../lib/messages';
interface Props { context?: DocsContext }
const { context = defaultContext } = Astro.props;
const path = parseDocsPath(Astro.url.pathname)?.path ?? '/';
const target = (next: DocsContext) => docsPath(path.startsWith('/guides/') && !findArticle(path.slice(8), next) ? '/' : path, next);
const version = docsyConfig.versions.items.find((item) => item.id === context.version)!;
---
{(docsyConfig.versions.items.length > 1 || locales.length > 1) && (
  <div class="docs-context-bar">
    {docsyConfig.versions.items.length > 1 && <label>{message(context, 'version')}
      <span class="docs-context-select">
        <select data-docsy-context-switch aria-label={message(context, 'version')}>
          {docsyConfig.versions.items.map((item) => <option value={target({ ...context, version: item.id })} selected={item.id === context.version}>{item.label}</option>)}
        </select>
        <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </span>
    </label>}
    {locales.length > 1 && <label>{message(context, 'language')}
      <span class="docs-context-select">
        <select data-docsy-context-switch aria-label={message(context, 'language')}>
          {locales.map((item) => <option value={target({ ...context, locale: item.code })} selected={item.code === context.locale}>{item.label}</option>)}
        </select>
        <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </span>
    </label>}
  </div>
)}
{version.status !== 'current' && <div class="docs-context-notice">{message(context, version.status)}</div>}
<script>
  document.querySelectorAll<HTMLSelectElement>('[data-docsy-context-switch]').forEach((select) => {
    select.addEventListener('change', () => { window.location.assign(select.value); });
  });
</script>
