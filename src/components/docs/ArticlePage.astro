---
import type { ArticleDoc } from '../../lib/article-loader';
import { articleUrl, getArticleSources } from '../../lib/article-loader';
import { defaultContext, docsyConfig, type DocsContext } from '../../config';
import { message } from '../../lib/messages';
import { readerLinks } from '../../lib/reader-links';
import ArticleCredits from './ArticleCredits.astro';

interface Props {
  article: ArticleDoc;
  context?: DocsContext;
}

const { article, context = defaultContext } = Astro.props;
const articles = getArticleSources(context);
const index = articles.findIndex((item) => item.slug === article.config.slug);
const previous = articles[index - 1]; const next = articles[index + 1];
const links = readerLinks(article, context);
---

<article class="article-page">
  {(article.config.locale ?? defaultContext.locale) !== context.locale && <div class="docs-context-notice">{message(context, 'fallback')}</div>}
  <header class="article-header" lang={article.config.locale ?? defaultContext.locale}>
    <h1>{article.config.title}</h1>
    {article.config.description && <p class="article-description">{article.config.description}</p>}
    <ArticleCredits article={article.config} context={context} editUrl={links.edit} />
  </header>
  <div class="article-body" lang={article.config.locale ?? defaultContext.locale} set:html={article.html} />
  {links.report && <div class="article-source-actions" aria-label={message(context, 'documentationFeedback')}>
    {links.report && <a href={links.report} target="_blank" rel="noopener noreferrer">{message(context, 'reportProblem', docsyConfig.reader.reportLabel)} <span aria-hidden="true">↗</span></a>}
  </div>}
  <nav class="article-reader-nav" aria-label={message(context, 'articleNavigation')}>
    {previous ? <a href={articleUrl(previous, context)}>← {message(context, 'previous')}: {previous.title}</a> : <span />}
    {next && <a href={articleUrl(next, context)}>{message(context, 'next')}: {next.title} →</a>}
  </nav>
</article>

<style>
  .article-source-actions { display:flex; flex-wrap:wrap; gap:24px; margin:44px 0 26px; padding-top:20px; border-top:1px solid var(--line); }
  .article-source-actions a { color:var(--muted); font-size:13px; text-decoration:none; letter-spacing:normal; }
  .article-source-actions a:hover { color:var(--ink); text-decoration:underline; text-underline-offset:4px; }
  .article-source-actions a:focus-visible { outline:2px solid var(--violet); outline-offset:5px; border-radius:2px; }
  .article-header {
    margin-bottom: 40px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--line);
  }

  .article-description {
    max-width: 680px;
    margin-bottom: 0 !important;
    color: var(--muted) !important;
    font-size: 18px !important;
    line-height: 1.55 !important;
  }

  .article-body :global(h2),
  .article-body :global(h3) {
    scroll-margin-top: 90px;
  }

  .article-body :global(p),
  .article-body :global(li) {
    color: var(--muted);
  }

  .article-body :global(blockquote) {
    margin: 24px 0;
    padding: 2px 0 2px 18px;
    border-left: 3px solid var(--violet);
  }

  .article-body :global(blockquote p) {
    margin: 0;
  }

  .article-body :global(pre:not(.cb-pre)) {
    max-width: 100%;
    margin: 22px 0 28px;
    overflow: auto;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--panel);
  }

  .article-body :global(pre:not(.cb-pre) code) {
    display: block;
    min-width: max-content;
    padding: 20px 22px;
    border-radius: 0;
    background: transparent;
    color: #f3f4f6;
    font-size: 13px;
    line-height: 1.65;
  }

  .article-body :global(table) {
    width: 100%;
    margin: 22px 0 30px;
    border-collapse: collapse;
    font-size: 14px;
  }

  .article-body :global(th),
  .article-body :global(td) {
    padding: 11px 12px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    text-align: start;
    vertical-align: top;
  }

  .article-body :global(th) {
    color: var(--ink);
    font-weight: 650;
  }

</style>
