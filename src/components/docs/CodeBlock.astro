---
interface Props {
  code: string;
  language?: string;
  title?: string;
}

const { code, language = 'typescript', title } = Astro.props;
const codeId = `code-${Math.random().toString(36).slice(2, 10)}`;
---

<div class="cb">
  {title && (
    <div class="cb-head">
      <span class="cb-title">{title}</span>
      <span class="cb-lang">{language}</span>
    </div>
  )}
  <div class="cb-body">
    <pre><code id={codeId} class:list={[`language-${language}`]}>{code}</code></pre>
    <button
      type="button"
      class="cb-copy"
      data-copy-target={codeId}
      aria-label="Copy code"
    >
      <span class="cb-copy-default" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="14" height="14"><path d="M4 4h7v7H4z M6 2h7v7" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg>
      </span>
      <span class="cb-copy-done" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="14" height="14"><path d="M4 8.5l2.5 2.5L12 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </span>
    </button>
  </div>
</div>

<style is:global>
  .cb {
    margin: 20px 0;
    border-radius: 12px;
    border: 1px solid #e1e2ea;
    background: #0f1015;
    overflow: hidden;
  }

  .cb-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background: rgba(255, 255, 255, 0.04);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .cb-title {
    color: rgba(255, 255, 255, 0.72);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .cb-lang {
    color: rgba(255, 255, 255, 0.4);
    font-family: var(--font-mono);
    font-size: 10.5px;
    text-transform: uppercase;

    font-weight: 700;
  }

  .cb-body {
    position: relative;
  }

  .cb pre {
    margin: 0;
    padding: 16px 18px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 13.5px;
    line-height: 1.65;
  }

  .cb pre code {
    background: transparent !important;
    padding: 0 !important;
    color: #e6e8f0;
    font-family: inherit;
    font-size: inherit;
  }

  /* Let hljs paint token colours but keep our card background */
  .cb pre code.hljs {
    background: transparent !important;
    padding: 0 !important;
  }

  .cb-copy {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 30px;
    height: 30px;
    border-radius: 7px;
    border: 0;
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.72);
    display: inline-grid;
    place-items: center;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s ease, background 0.15s ease;
  }

  .cb:hover .cb-copy,
  .cb-copy:focus-visible {
    opacity: 1;
  }

  .cb-copy:hover {
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
  }

  .cb-copy-done {
    display: none;
    color: #57c468;
  }

  .cb-copy.is-copied .cb-copy-default {
    display: none;
  }

  .cb-copy.is-copied .cb-copy-done {
    display: inline-grid;
    place-items: center;
  }
</style>
