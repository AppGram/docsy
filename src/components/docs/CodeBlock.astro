---
import { renderCodeCard } from '../../lib/code-renderer';
import '../../styles/code-blocks.css';

interface Props {
  code: string;
  language?: string;
  title?: string;
}

const { code, language = 'text', title = 'Code' } = Astro.props;
const html = await renderCodeCard(code, language, title);
---

<Fragment set:html={html} />
