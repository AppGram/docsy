---
import ArticleToc from '../../components/docs/ArticleToc.astro';
import ArticlePage from '../../components/docs/ArticlePage.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { docsPath, docsyConfig, isServer, type ArticleConfig } from '../../config';
import { findArticle, getArticleSources, loadArticle, type ArticleDoc } from '../../lib/article-loader';
import { articleAuthorship, articleStructuredData } from '../../lib/authorship';

export const prerender = !isServer;

export async function getStaticPaths() {
  return Promise.all(getArticleSources().map(async (source) => ({
    params: { slug: source.slug },
    props: { source, article: await loadArticle(source) },
  })));
}

const source = (Astro.props as { source?: ArticleConfig }).source
  ?? findArticle(Astro.params.slug ?? '');
if (!source) return Astro.rewrite(docsPath('/404'));
const article = (Astro.props as { article?: ArticleDoc }).article ?? await loadArticle(source);
const toc = article.headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<DocsLayout
  title={`${article.config.title} — ${docsyConfig.site.name} Docs`}
  description={article.config.description || docsyConfig.site.description}
  eyebrow={article.config.eyebrow}
  type="article"
  publishedAt={article.config.publishedAt}
  updatedAt={article.config.updatedAt}
  authorName={articleAuthorship(article.config).authors.map((author) => author.name).join(', ') || undefined}
  structuredData={articleStructuredData(article.config)}
  wide={article.headings.some((heading) => heading.depth === 2 || heading.depth === 3)}
>
  <ArticlePage article={article} />
  {toc.length > 0 && <ArticleToc slot="toc" headings={toc} />}
</DocsLayout>
