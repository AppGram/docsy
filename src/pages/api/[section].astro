---
import DocsLayout from '../../layouts/DocsLayout.astro';
import EndpointCard from '../../components/docs/EndpointCard.astro';
import EndpointToc from '../../components/docs/EndpointToc.astro';
import { docsPath, docsyConfig } from '../../config';
import { API_SECTIONS, filterEndpoints, loadSwagger, type ApiSection, type NormalizedEndpoint } from '../../lib/swagger-loader';

export const prerender = docsyConfig.access.mode !== 'locked';

export async function getStaticPaths() {
  const { loadSwagger, filterEndpoints, API_SECTIONS } = await import('../../lib/swagger-loader');
  const spec = await loadSwagger();
  return API_SECTIONS.map((section) => ({
    params: { section: section.section },
    props: {
      section,
      endpoints: filterEndpoints(spec, section),
      apiVersion: spec?.info?.version,
    },
  }));
}

let { section, endpoints, apiVersion } = Astro.props as {
  section?: ApiSection;
  endpoints?: NormalizedEndpoint[];
  apiVersion?: string;
};
if (!section) {
  section = API_SECTIONS.find((candidate) => candidate.section === Astro.params.section);
  if (!section) return Astro.redirect(docsPath(), 302);
  const spec = await loadSwagger();
  endpoints = filterEndpoints(spec, section);
  apiVersion = spec?.info?.version;
}
endpoints ??= [];
const apiGuide = docsyConfig.ingestion.openapi.guide;
const displayApiVersion = apiVersion?.replace(/^v/i, '');
---

<DocsLayout
  title={`${section.title} — ${docsyConfig.site.name} API`}
  description={section.description}
  eyebrow="API REFERENCE"
  wide
>
  <div class="ep-hero">
    <div>
      <h1>{section.title}</h1>
      <p class="lead">{section.description}</p>
    </div>
    {displayApiVersion && (
      <span class="ep-hero-version">v{displayApiVersion}</span>
    )}
  </div>

  <div class="ep-hero-meta">
    <span class="ep-hero-pill"><strong>{endpoints.length}</strong> {endpoints.length === 1 ? 'endpoint' : 'endpoints'}</span>
    {apiGuide && <a class="ep-hero-link" href={docsPath(apiGuide.href)}>{apiGuide.label} &rarr;</a>}
  </div>

  {endpoints.length === 0 ? (
    <div class="ep-empty">
      <p>
        No endpoints match this section in the current OpenAPI spec.
        {apiGuide && <> Check <a href={docsPath(apiGuide.href)}>{apiGuide.label}</a> for the base setup.</>}
      </p>
    </div>
  ) : (
    endpoints.map((endpoint) => <EndpointCard endpoint={endpoint} />)
  )}

  <EndpointToc slot="toc" endpoints={endpoints} />
</DocsLayout>

<style is:global>
  .ep-hero {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 8px;
  }

  .ep-hero h1 {
    margin: 0 !important;
  }

  .ep-hero-version {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    height: 24px;
    padding: 0 10px;
    border-radius: 999px;
    background: rgba(81, 136, 255, 0.12);
    color: var(--violet-dark);
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 700;

  }

  .ep-hero-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 12px 0 32px;
  }

  .ep-hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 999px;
    background: #f4f4f8;
    color: var(--muted);
    font-size: 12.5px;
    line-height: 1;
  }

  .ep-hero-pill strong {
    color: var(--ink);
    font-weight: 650;
  }

  .ep-hero-link {
    color: var(--violet) !important;
    font-size: 13px;
    font-weight: 650;
  }

  .ep-empty {
    padding: 32px;
    text-align: center;
    border-radius: 12px;
    border: 1px dashed #d8d8e0;
    background: #fafafd;
    color: var(--muted);
  }

  .ep-empty p {
    margin: 0 !important;
    font-size: 14px !important;
  }

  .ep-toc {
    margin: 0 0 40px;
    padding: 16px 20px;
    border-radius: 12px;
    background: #fafafd;
    border: 1px solid #ebebf1;
  }

  .ep-toc-label {
    margin: 0 0 10px !important;
    color: var(--soft-muted) !important;
    font-family: var(--font-display);
    font-size: 12.5px !important;
    font-weight: 500 !important;
  }

  .ep-toc ul {
    list-style: none;
    margin: 0 !important;
    padding: 0 !important;
    display: grid;
    gap: 4px;
  }

  .ep-toc li {
    margin: 0 !important;
  }

  .ep-toc a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 4px 6px;
    border-radius: 6px;
    text-decoration: none !important;
    color: var(--ink) !important;
    font-size: 13px;
    transition: background 0.12s ease;
  }

  .ep-toc a:hover {
    background: #fff;
  }

  .ep-toc-method {
    display: inline-flex;
    align-items: center;
    height: 18px;
    padding: 0 6px;
    border-radius: 4px;
    color: #fff;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;

    flex-shrink: 0;
  }

  .ep-toc-method.is-get    { background: #2b7cff; }
  .ep-toc-method.is-post   { background: #2c8b3a; }
  .ep-toc-method.is-put    { background: #b96f00; }
  .ep-toc-method.is-patch  { background: #b96f00; }
  .ep-toc-method.is-delete { background: #c73f28; }

  .ep-toc-path {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1;
    min-width: 0;
  }
</style>
