---
import APIReferenceView from '../../components/docs/APIReferenceView.astro';
import { docsPath, isServer } from '../../config';
import { API_SECTIONS, filterEndpoints, loadSwagger } from '../../lib/swagger-loader';
export const prerender = !isServer;
export function getStaticPaths() { return API_SECTIONS.map((section) => ({ params: { section: section.section } })); }
const section = API_SECTIONS.find((item) => item.section === Astro.params.section);
if (!section) return Astro.redirect(docsPath(), 302);
const spec = await loadSwagger();
---
<APIReferenceView section={section} endpoints={filterEndpoints(spec, section)} apiVersion={spec?.info?.version} />
