---
import DocsLayout from '../layouts/DocsLayout.astro';
import { docsPath, docsyConfig } from '../config';
import { tierDetails } from '../lib/access';

const { gate } = docsyConfig.access;
const requestedReturnTo = Astro.url.searchParams.get('returnTo') ?? docsPath();
const returnTo = requestedReturnTo.startsWith(`${docsPath()}/`) || requestedReturnTo === docsPath()
  ? requestedReturnTo
  : docsPath();
const required = (Astro.url.searchParams.get('required') ?? '').split(',').filter(Boolean);
const tiers = tierDetails(required);
const signedIn = Astro.url.searchParams.get('reason') === 'tier';

let loginHref: string | undefined;
if (gate.loginUrl) {
  const login = new URL(gate.loginUrl, docsyConfig.site.origin);
  login.searchParams.set(gate.returnToParam, new URL(returnTo, docsyConfig.site.origin).toString());
  loginHref = login.toString();
}
---

<DocsLayout
  title={`${gate.title} — ${docsyConfig.site.name} Docs`}
  description={gate.description}
  eyebrow={gate.eyebrow}
  noindex
>
  <section class="access-gate" aria-labelledby="access-gate-title">
    <div class="access-gate-mark" aria-hidden="true">
      <span class="access-gate-orbit"></span>
      <svg viewBox="0 0 32 32" width="32" height="32">
        <rect x="7" y="14" width="18" height="14" rx="3" fill="none" stroke="currentColor" stroke-width="1.8" />
        <path d="M11 14v-3.2a5 5 0 0 1 10 0V14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        <circle cx="16" cy="20.5" r="1.5" fill="currentColor" />
        <path d="M16 22v2.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </div>

    <p class="access-gate-kicker">{signedIn ? 'Upgrade required' : 'Permission gate'}</p>
    <h1 id="access-gate-title">{gate.title}</h1>
    <p class="lead">{gate.description}</p>

    {tiers.length > 0 && (
      <div class="access-tier-block">
        <p class="access-tier-label">Available on</p>
        <div class="access-tier-list">
          {tiers.map((tier) => (
            <div class="access-tier">
              <span class="access-tier-dot"></span>
              <div>
                <strong>{tier.label}</strong>
                {tier.description && <span>{tier.description}</span>}
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <div class="access-gate-actions">
      {loginHref && <a class="button button-dark" href={loginHref}>{gate.loginLabel}</a>}
      <a class="access-gate-back" href={docsPath()}>{gate.backLabel} <span aria-hidden="true">&rarr;</span></a>
    </div>
  </section>
</DocsLayout>

<style>
  .access-gate {
    position: relative;
    isolation: isolate;
    margin-top: 10px;
    padding: 56px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 14px;
    background:
      linear-gradient(135deg, rgba(81, 136, 255, 0.07), transparent 42%),
      var(--paper);
    box-shadow: 0 32px 70px -54px rgba(17, 17, 22, 0.6);
  }

  .access-gate::after {
    content: "";
    position: absolute;
    z-index: -1;
    right: -90px;
    top: -110px;
    width: 300px;
    height: 300px;
    border: 1px solid rgba(81, 136, 255, 0.16);
    border-radius: 50%;
    box-shadow:
      0 0 0 34px rgba(81, 136, 255, 0.035),
      0 0 0 72px rgba(81, 136, 255, 0.02);
  }

  .access-gate-mark {
    position: relative;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    margin-bottom: 30px;
    border: 1px solid rgba(81, 136, 255, 0.25);
    border-radius: 50%;
    color: var(--ink);
    background: color-mix(in srgb, var(--paper) 92%, var(--ink));
    box-shadow: 0 16px 30px -22px rgba(61, 111, 230, 0.8);
  }

  .access-gate-orbit {
    position: absolute;
    inset: -7px;
    border: 1px dashed rgba(81, 136, 255, 0.22);
    border-radius: inherit;
  }

  .access-gate-kicker {
    margin: 0 0 10px !important;
    color: var(--violet-dark) !important;
    font-family: var(--font-label);
    font-size: 11px !important;
    font-weight: 750 !important;

    text-transform: uppercase;
  }

  .access-gate h1 {
    max-width: 560px;
    margin-bottom: 14px !important;
  }

  .access-gate > .lead {
    max-width: 600px;
    margin-bottom: 0 !important;
  }

  .access-tier-block {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .access-tier-label {
    margin: 0 0 12px !important;
    color: var(--soft-muted) !important;
    font-family: var(--font-label);
    font-size: 11px !important;
    font-weight: 700 !important;

    text-transform: uppercase;
  }

  .access-tier-list {
    display: grid;
    gap: 8px;
  }

  .access-tier {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: color-mix(in srgb, var(--paper) 94%, var(--ink));
  }

  .access-tier-dot {
    width: 7px;
    height: 7px;
    margin-top: 6px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--violet);
    box-shadow: 0 0 0 4px rgba(81, 136, 255, 0.1);
  }

  .access-tier strong,
  .access-tier span {
    display: block;
  }

  .access-tier strong {
    color: var(--ink);
    font-size: 13.5px;
    font-weight: 680;
  }

  .access-tier div > span {
    margin-top: 2px;
    color: var(--muted);
    font-size: 12.5px;
    line-height: 1.45;
  }

  .access-gate-actions {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 30px;
  }

  .access-gate-back {
    color: var(--muted) !important;
    font-size: 13px;
    font-weight: 650;
    text-decoration: none !important;
  }

  .access-gate-back:hover {
    color: var(--ink) !important;
  }

  @media (max-width: 640px) {
    .access-gate {
      padding: 34px 24px;
    }

    .access-gate-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .access-gate-back {
      text-align: center;
    }
  }
</style>
