---
import DocsLayout from '../layouts/DocsLayout.astro';
import ArticleCard from '../components/docs/ArticleCard.astro';
import { assetPath, docsPath, docsyConfig } from '../config';
import { API_SECTIONS, filterEndpoints, loadSwagger } from '../lib/swagger-loader';
import { getArticleSources } from '../lib/article-loader';

const spec = await loadSwagger();
const apiSections = API_SECTIONS.map((section) => ({
  ...section,
  endpointCount: filterEndpoints(spec, section).length,
  href: docsPath(`/api/${section.section}`),
}));
const articles = getArticleSources();
---

<DocsLayout
  title={docsyConfig.site.title}
  description={docsyConfig.site.description}
  eyebrow={docsyConfig.home.eyebrow}
>
  <div class:list={['docs-intro', { 'has-image': Boolean(docsyConfig.home.image) }]}>
    <div class="docs-intro-copy">
      <h1>{docsyConfig.home.title}</h1>
      <p class="lead">{docsyConfig.home.description}</p>

      <div class="docs-cta-row">
        <a class="button button-dark" href={docsPath(docsyConfig.home.primaryAction.href)}>{docsyConfig.home.primaryAction.label}</a>
        {docsyConfig.home.secondaryAction && (
          <a class="button button-light" href={docsPath(docsyConfig.home.secondaryAction.href)}>{docsyConfig.home.secondaryAction.label}</a>
        )}
      </div>
    </div>

    {docsyConfig.home.image && (
      <img
        class="docs-intro-art"
        src={assetPath(docsyConfig.home.image.src)}
        alt={docsyConfig.home.image.alt}
        width={docsyConfig.home.image.width}
        height={docsyConfig.home.image.height}
      />
    )}
  </div>

  {articles.length > 0 && (
    <>
      <h2>Guides</h2>
      <p class="docs-section-description">Authored Markdown registered under <code>content.articles</code> in <code>docsy.config.yaml</code>.</p>
      <div class:list={['docs-article-grid', { 'is-list': docsyConfig.home.articleLayout === 'list' }]}>
        {articles.map((article) => (
          <ArticleCard article={article} layout={docsyConfig.home.articleLayout} />
        ))}
      </div>
    </>
  )}

  {apiSections.length > 0 && <h2>API reference</h2>}
  {apiSections.length > 0 && <p class="docs-section-description">Generated from the OpenAPI source configured in <code>docsy.config.yaml</code>.</p>}

  {apiSections.length > 0 && (
    <div class="docs-sdk-grid">
      {apiSections.map((section) => (
        <a class="docs-sdk-card" href={section.href}>
          <div class="docs-sdk-head">
            <span class="docs-sdk-mark" aria-hidden="true">
              <img src={assetPath('assets/sdks/bash.svg')} alt="" width="24" height="24" loading="lazy" />
            </span>
            <span class="docs-sdk-arrow" aria-hidden="true">&rarr;</span>
          </div>
          <h3>{section.title}</h3>
          <p>{section.description}</p>
          <div class="docs-sdk-meta">
            {section.endpointCount} {section.endpointCount === 1 ? 'endpoint' : 'endpoints'}
          </div>
        </a>
      ))}
    </div>
  )}
</DocsLayout>

<style is:global>
  .docs-intro.has-image {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.35fr);
    gap: 28px;
    align-items: center;
  }

  .docs-intro-copy > h1 {
    margin-top: 0;
  }

  .docs-intro-art {
    width: 100%;
    height: auto;
    justify-self: end;
  }

  .docs-cta-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin: 24px 0 40px;
  }

  .docs-section-description {
    color: var(--muted) !important;
  }

  .docs-sdk-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin: 20px 0 24px;
  }

  .docs-article-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 24px 0;
  }

  .docs-article-grid.is-list {
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
  }

  .docs-sdk-card {
    display: block;
    min-width: 0;
    padding: 20px;
    border-radius: 14px;
    border: 1px solid #e1e2ea;
    background: var(--paper);
    text-decoration: none !important;
    color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  .docs-sdk-card:hover {
    border-color: rgba(81, 136, 255, 0.36);
    transform: translateY(-2px);
    box-shadow: 0 12px 26px -18px rgba(15, 16, 21, 0.2);
  }

  .docs-sdk-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .docs-sdk-mark {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: #fafafd;
    border: 1px solid #ebebf1;
  }

  .docs-sdk-arrow {
    color: var(--soft-muted);
    font-size: 14px;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .docs-sdk-card:hover .docs-sdk-arrow {
    color: var(--violet);
    transform: translateX(3px);
  }

  .docs-sdk-card h3 {
    margin: 0 0 4px !important;
    font-family: var(--font-display);
    font-size: 17px !important;
    font-weight: 500;
    color: var(--ink) !important;
  }

  .docs-sdk-card p {
    margin: 0 0 14px !important;
    color: var(--muted) !important;
    font-size: 13px !important;
    line-height: 1.5 !important;
  }

  .docs-sdk-meta {
    padding-top: 12px;
    border-top: 1px solid #ececf2;
    color: var(--soft-muted);
    font-family: var(--font-mono);
    font-size: 11.5px;
  }

  @media (max-width: 1000px) {
    .docs-intro.has-image {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .docs-intro-art {
      justify-self: start;
      max-width: 640px;
    }
  }

  @media (max-width: 720px) {
    .docs-sdk-grid,
    .docs-article-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
