---
import { docsyConfig, docsPath, isServer } from '../config';
export const prerender = !isServer;
export function getStaticPaths() {
  return Object.keys(docsyConfig.redirects).map((from) => ({ params: { redirect: from.replace(/^\/+|\/+$/g, '') } }));
}
const from = `/${(Astro.params.redirect ?? '').replace(/^\/+|\/+$/g, '')}`;
const target = docsyConfig.redirects[from] ?? docsyConfig.redirects[`${from}/`];
if (!target) return Astro.rewrite(docsPath('/404'));
return Astro.redirect(docsPath(target), 301);
---
