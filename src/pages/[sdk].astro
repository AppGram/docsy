---
import SDKReferenceView from '../components/docs/SDKReferenceView.astro';
import { docsPath, isServer } from '../config';
import { getSdkSources } from '../lib/sdk-loaders';
export const prerender = !isServer;
export function getStaticPaths() { return getSdkSources().map((source) => ({ params: { sdk: source.slug } })); }
const source = getSdkSources().find((item) => item.slug === Astro.params.sdk);
if (!source) return Astro.redirect(docsPath(), 302);
---
<SDKReferenceView source={source} />
