# Keep the tested Node build toolchain; use Bun only for the production runtime.
FROM node:22-slim AS build
WORKDIR /app
COPY package*.json ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi
COPY . .
ARG DOCSY_CONFIG=docsy.config.yaml
ENV DOCSY_CONFIG=${DOCSY_CONFIG}
RUN npm run build

FROM oven/bun:1.3.5-slim
WORKDIR /app
ENV HOST=0.0.0.0
ENV PORT=8080
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/docsy.config.yaml ./docsy.config.yaml
COPY --from=build /app/dist ./dist
COPY --from=build /app/release ./release
COPY --from=build /app/public ./public
COPY --from=build /app/sources ./sources
COPY --from=build /app/content ./content
COPY --from=build /app/scripts/start.mjs ./scripts/start.mjs
EXPOSE 8080
CMD ["bun", "scripts/start.mjs"]
