{
  "name": "@appgram/docsy",
  "version": "0.4.0",
  "private": false,
  "description": "Documentation built for humans and coding agents. Self-host Markdown, OpenAPI, and SDK docs with editable Astro source.",
  "license": "Elastic-2.0",
  "author": {
    "name": "nedimf",
    "url": "https://github.com/nedimf"
  },
  "keywords": ["documentation", "docs", "openapi", "mdx", "astro", "self-hosted", "sdk", "cli", "coding-agents"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AppGram/docsy.git"
  },
  "bugs": {
    "url": "https://github.com/AppGram/docsy/issues"
  },
  "homepage": "https://appgram.github.io/docsy/",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": {
    "docsy": "scripts/docsy.mjs",
    "create-docsy": "scripts/create-docsy.mjs"
  },
  "files": [
    "LICENSE",
    ".github/workflows/docsy-maintenance.yml",
    "content",
    "sources",
    "src",
    "public",
    "scripts",
    ".dockerignore",
    ".gitignore",
    "astro.config.mjs",
    "compose.yaml",
    "Dockerfile",
    "Dockerfile.bun",
    "docsy.config.yaml",
    "README.md",
    "CHANGELOG.md",
    "docs/npm-release.md",
    "tsconfig.json"
  ],
  "scripts": {
    "release:pack": "node scripts/pack-package.mjs",
    "prepublishOnly": "node scripts/release/prepublish.mjs",
    "test:package": "node scripts/test-package.mjs",
    "docsy": "node scripts/docsy.mjs",
    "create": "node scripts/create-docsy.mjs",
    "dev": "node scripts/docsy.mjs dev",
    "validate": "node scripts/docsy.mjs validate",
    "build": "node scripts/docsy.mjs build",
    "stage": "node scripts/stage-deployment.mjs",
    "preview": "node scripts/docsy.mjs preview",
    "start": "node scripts/start.mjs",
    "start:bun": "bun scripts/start.mjs",
    "check": "node scripts/docsy.mjs validate",
    "maintain": "node scripts/docsy.mjs maintain",
    "test": "node --import tsx --test tests/*.test.mjs tests/*.test.ts",
    "test:runtime:bun": "DOCSY_TEST_RUNTIME=bun node --import tsx --test tests/platform.integration.test.ts",
    "fixtures:generate": "node scripts/generate-native-fixtures.mjs",
    "fixtures:image": "docker build -t docsy-generators:local -f tests/generators/Dockerfile tests/generators",
    "test:maintenance:live": "node tests/maintenance.live.mjs",
    "test:maintenance:real": "node tests/maintenance.real.mjs --run-agent",
    "test:requests:live": "node --import tsx tests/request-examples.live.mjs",
    "test:imports:real": "node --import tsx scripts/prove-real-imports.ts --render"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/node": "^11.1.8",
    "@mdx-js/mdx": "^3.1.1",
    "@readme/httpsnippet": "^11.4.1",
    "@redocly/openapi-core": "^2.64.1",
    "astro": "^7.4.0",
    "esbuild": "^0.28.2",
    "fast-xml-parser": "^5.11.2",
    "fast-xml-validator": "^1.4.2",
    "hast-util-to-html": "^9.0.5",
    "js-yaml": "^4.2.0",
    "parse5": "^8.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "shiki": "^4.5.0",
    "tsx": "^4.23.15",
    "unified": "^11.0.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdoc": "^4.0.5",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
